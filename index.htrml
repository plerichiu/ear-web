<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Redirecting...</title>
    
    <meta http-equiv="refresh" content="0; url=/res">
    
    <script>
        // Instant JavaScript redirect fallback
        window.location.href = "/res";
    </script>
</head>
<body>
    <p>If you are not redirected automatically, <a href="/res">click here</a>.</p>
</body>
</html>
